# =============================================================================
# Soundboard Bot — exemple de configuration
#
# Copiez ce fichier en `.env` et renseignez au minimum DISCORD_TOKEN.
# Toutes les autres variables ont une valeur par défaut : les lignes
# commentées montrent cette valeur, il suffit de les décommenter pour la
# changer.
# =============================================================================


# --- Obligatoire -------------------------------------------------------------

# Token du bot, depuis https://discord.com/developers/applications
# (onglet Bot > Reset Token). Ne le partagez jamais.
DISCORD_TOKEN=votre_token_ici


# --- Intents privilégiés -----------------------------------------------------
# Ces deux intents doivent AUSSI être cochés dans le portail développeur
# Discord, onglet Bot > Privileged Gateway Intents. Si la variable est à
# true mais l'intent décoché côté portail, la connexion est refusée.

# "Server Members" : nécessaire pour que la condition de rôle et la
# résolution des membres soient fiables. Mettez false pour vous en passer.
#MEMBERS_INTENT=true

# "Message Content" : requis uniquement pour le déclencheur de routine
# « un message contient un mot ». Sans lui, le bot ne voit que des messages
# vides et ce déclencheur ne part jamais.
#MESSAGE_CONTENT_INTENT=false


# --- Statut affiché sur Discord ----------------------------------------------

# playing, listening, watching, competing, custom
#ACTIVITY_TYPE=listening

# Texte affiché. Laissez vide pour n'afficher aucune activité.
#ACTIVITY_TEXT=/play | /help

# online, idle, dnd, invisible
#STATUS=online


# --- Volume ------------------------------------------------------------------
# Trois niveaux : le volume courant d'un serveur, son plafond (réglable par
# les administrateurs avec /config), et le plafond absolu que /config ne peut
# pas dépasser.

# Volume de départ d'un nouveau serveur, en %
#DEFAULT_VOLUME=70

# Plafond par défaut d'un serveur, en %. Modifiable ensuite serveur par
# serveur via /config.
#MAX_VOLUME=200

# Plafond absolu, non modifiable depuis Discord. Empêche un administrateur
# de se donner un volume délirant. Au-delà de 100%, le son sature.
#VOLUME_HARD_LIMIT=500


# --- Limites d'ajout des sons ------------------------------------------------
# Valeurs par défaut ; chaque serveur peut les ajuster avec /config.
# 0 signifie « illimité ».

# Durée maximale d'un son, en secondes
#MAX_DURATION_SECONDS=30

# Taille maximale d'un fichier, en Mo
#MAX_FILE_SIZE_MB=5

# Longueur maximale du nom d'un son
#MAX_NAME_LENGTH=32


# --- Comportement vocal ------------------------------------------------------

# Délai d'inactivité avant que le bot quitte le vocal, en secondes
#VOICE_TIMEOUT_SECONDS=300


# --- Chemins -----------------------------------------------------------------
# Par défaut, `sounds/` et `data/` à la racine du projet. À surcharger en
# conteneur, où les volumes ne sont pas montés à côté du code.

#SOUNDS_DIR=/app/sounds
#DATA_DIR=/app/data
#DB_FILE=/app/data/soundboard.db


# --- Journalisation ----------------------------------------------------------

# DEBUG_MODE=true passe LOG_LEVEL à DEBUG, ce qui logue chaque requête
# SQLite. Très verbeux : à réserver au diagnostic.
#DEBUG_MODE=false

# DEBUG, INFO, WARNING, ERROR
#LOG_LEVEL=INFO
